# ==============================================================================
# Dockerfile.server: Cross-Silo Federated Learning Central Aggregator
# ==============================================================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    MPLCONFIGDIR=/tmp/matplotlib_cache \
    PYTHONPATH=/app

# 1. Install networking & debugging tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    iproute2 \
    iputils-ping \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Install lightweight CPU PyTorch and project dependencies
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch torchvision && \
    pip install --no-cache-dir -r requirements.txt

# 3. Copy application codebase
COPY src /app/src
COPY configs /app/configs
COPY scripts /app/scripts

# Expose FL coordinator port (8080) and Prometheus metrics port (9090)
EXPOSE 8080 9090

# Default entrypoint for FL Server
CMD ["python3", "-m", "src.systems.server_node"]

